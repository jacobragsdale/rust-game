// Testbed: secrets and story — a trigger, a trigger that waits on a flag, and
// a false wall with a chest behind it. Frozen once shipped, like every
// testbed: tapes encode its pixels. Add to it; do not move what is here.
//
//   spawn        col 2, row 6
//   trigger A    col 5, rows 4-6 — tells `testbed_trigger`, once
//   trigger B    col 8, rows 4-6 — tells `testbed_trigger_late`, but only
//                once `quest.testbed.bell` is set
//   bell rope    col 9, row 6 — a lever that rings it
//   false wall   col 11, rows 4-6 — drawn as the stone above it, walked
//                through; the wall above it is real and reaches the ceiling
//   chest        col 14, row 6 — the secret
Level(
    tileset: "castle",
    name: "Testbed: Secrets",
    grid: [
        "##################",
        "#..........#.....#",
        "#..........#.....#",
        "#..........#.....#",
        "#..........%.....#",
        "#..........%.....#",
        "#.P........%.....#",
        "##################",
    ],
    entities: [
        Trigger(id: "hello", cell: (5, 4), dialogue: "testbed_trigger"),
        Trigger(id: "late", cell: (8, 4), dialogue: "testbed_trigger_late", when: "quest.testbed.bell"),
        Lever(id: "bell", cell: (9, 6), flag: "quest.testbed.bell"),
        Chest(id: "secret_chest", cell: (14, 6), items: [("coin", 5)]),
    ],
)
