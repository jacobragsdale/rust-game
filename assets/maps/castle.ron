// Castle interior — first adventure map.
// Legend: '#' solid  '=' one-way platform  '^' spikes  'P' spawn  'K' knight
// Each character is one 32px tile. The chimney on the right (cols 52-56)
// is a wall-jump climb; enter through the doorway at floor level.
// See src/level/ascii.rs.
//
// Headroom: the player is 34px tall, so a single empty row (32px) above a
// standable surface is NOT enough to stand in. Leave two. The solid blocks
// on row 6 used to sit on row 7, one tile above the row-9 platforms, which
// made those platforms impossible to land on — the player's head hit the
// block before their feet cleared the platform. `cargo test` now checks this;
// see src/level/validate.rs.
Level(
    tileset: "castle",
    name: "The Castle",
    grid: [
        "############################################################",
        "#..........................................................#",
        "#...................................................#...#..#",
        "#...................................................#...#..#",
        "#...................====............................#...#..#",
        "#........................####................====...#...#..#",
        "#.....####.......................####...............#...#..#",
        "#.................====..............................#...#..#",
        "#...................................................#...#..#",
        "#.......====..................====......................#..#",
        "#..P..................................K.................#..#",
        "#%######....##################....##########....############",
        "#%%%%%%#....##################....##########....############",
        "#%%%%%%#....##################....##########....############",
        "########^^^^##################^^^^##########^^^^############",
        "############################################################",
    ],
    entities: [
        // Where the barracks lets out, beside the map's own `P`. A new game
        // starts in the barracks (assets/maps/keep.ron) and arrives here; the
        // castle's tapes start at `P` as they always have.
        Spawn(id: "keep", cell: (2, 10)),
        // The way out: at the bottom of the shaft on the far side of the
        // chimney, so leaving the castle is the wall-jump climb. Down into the
        // village.
        Door(id: "shaft", cell: (57, 10), to: "maps/village.ron", at: "castle_gate", art: "archway"),
        // The captain's cellar: behind where a new game starts, under the
        // floor. The floor tile in the corner (col 1) is false wall and so is
        // the cellar under it (cols 1-6, rows 12-13) — walk into the corner
        // and you drop in. The chest and the note show through the stone.
        Chest(id: "secret_cellar", cell: (5, 13), items: [("guard_ring", 1), ("coin", 5)]),
        Sign(cell: (3, 13), dialogue: "sign_cellar"),
    ],
)
