// Adventurer sprite sheet: 7 columns x 16 rows of 50x37 frames.
//
// IMPORTANT: this sheet's animations run SEQUENTIALLY across rows, not one per
// row. Frame index i lives at cell (i % 7, i / 7), and an animation whose
// length does not divide by seven wraps onto the next row mid-swing.
//
// The clips here were originally authored one-per-row, which happened to be
// right for the first six (idle 4, crouch 4, run 6, jump 4, somersault 4,
// fall 2 -- 24 frames, exactly filling rows 0-3) and wrong for everything
// after. That put `wall_slide` on the spell-cast frames and started `hurt` on
// the last frame of attack 3.
//
// The sequential layout, verified frame by frame against the art:
//
//    0-3   idle             43-47  attack1
//    4-7   crouch           48-53  attack2
//    8-13  run              54-59  attack3
//   14-17  jump             60-62  hurt
//   18-21  somersault       63-69  die
//   22-23  fall             70-73  sword draw
//   24-28  slide            74-77  sword sheath
//   29-31  stand            78-81  cast          <- `cast`
//   32-35  corner grab      82-85  cast loop     (unused: the cast is short)
//   36-40  corner climb     86-89  air attack 1
//   41-42  wall slide       90-93  air attack 2
//                           94-96  plunge ready  <- `plunge_ready`
//                          97-103  plunge spin   <- `plunge_loop`
//                         104-108  plunge slam   <- `plunge_impact`
//   109-111 blank
//
// 15 fps is exactly 4 ticks per frame, so an attack clip's length in ticks is
// frames * 4 -- which is what `attacks.ron` commits an attacker for.
ClipSet(
    sheet: "playerSpriteSheet",
    frame_size: (50.0, 37.0),
    clips: {
        "idle": Clip(
            frames: [(0, 0), (1, 0), (2, 0), (3, 0)],
            fps: 8.0,
            looping: true,
        ),
        "crouch": Clip(
            frames: [(4, 0), (5, 0), (6, 0), (0, 1)],
            fps: 8.0,
            looping: true,
        ),
        "run": Clip(
            frames: [(1, 1), (2, 1), (3, 1), (4, 1), (5, 1), (6, 1)],
            fps: 12.0,
            looping: true,
        ),
        "jump": Clip(
            frames: [(0, 2), (1, 2), (2, 2), (3, 2)],
            fps: 12.0,
            looping: false,
        ),
        "double_jump": Clip(
            frames: [(4, 2), (5, 2), (6, 2), (0, 3)],
            fps: 14.0,
            looping: false,
        ),
        "fall": Clip(
            frames: [(1, 3), (2, 3)],
            fps: 8.0,
            looping: true,
        ),
        // 24-28. Five frames of going low and fast.
        "slide": Clip(
            frames: [(3, 3), (4, 3), (5, 3), (6, 3), (0, 4)],
            fps: 15.0,
            looping: false,
        ),
        // 41-42. Was pointing at 79-80, the cast frames, which is why the
        // player threw a spell-hand up while clinging to a wall.
        "wall_slide": Clip(
            frames: [(6, 5), (0, 6)],
            fps: 8.0,
            looping: true,
        ),
        // 43-47. The big downward crescent lands on frame 1.
        "attack1": Clip(
            frames: [(1, 6), (2, 6), (3, 6), (4, 6), (5, 6)],
            fps: 15.0,
            looping: false,
        ),
        // 48-53. A wider sweep, crescent on frame 2.
        "attack2": Clip(
            frames: [(6, 6), (0, 7), (1, 7), (2, 7), (3, 7), (4, 7)],
            fps: 15.0,
            looping: false,
        ),
        // 54-59. The finisher: a long forward thrust.
        "attack3": Clip(
            frames: [(5, 7), (6, 7), (0, 8), (1, 8), (2, 8), (3, 8)],
            fps: 15.0,
            looping: false,
        ),
        // 86-89.
        "air_attack": Clip(
            frames: [(2, 12), (3, 12), (4, 12), (5, 12)],
            fps: 15.0,
            looping: false,
        ),
        // 60-62. Was starting at 59, the last frame of attack3.
        "hurt": Clip(
            frames: [(4, 8), (5, 8), (6, 8)],
            fps: 10.0,
            looping: false,
        ),
        // 63-69. A real death, rather than reusing `hurt` for it.
        "die": Clip(
            frames: [(0, 9), (1, 9), (2, 9), (3, 9), (4, 9), (5, 9), (6, 9)],
            fps: 12.0,
            looping: false,
        ),
        // 78-81. The spell-cast frames the wrongly-authored `wall_slide` used
        // to be pointing at; now they are cast by something that casts.
        // 16 ticks of `cast_ticks` + `recovery` against 4 frames at 15 fps.
        "cast": Clip(
            frames: [(1, 11), (2, 11), (3, 11), (4, 11)],
            fps: 15.0,
            looping: false,
        ),

        // --- the plunge, frames 94-108 ------------------------------------
        //
        // One long sequence in the art, split into the three phases the
        // mechanic has: raise, spin, slam. Verified frame by frame with
        // `cargo run --bin sheet -- player --clip plunge_loop`.

        // 94-96. Sword comes up overhead. Plays during the hover.
        "plunge_ready": Clip(
            frames: [(3, 13), (4, 13), (5, 13)],
            fps: 18.0,
            looping: false,
        ),
        // 97-103. The spin, which is a rotation and so genuinely loops —
        // a plunge from the top of a shaft cycles it several times.
        "plunge_loop": Clip(
            frames: [(6, 13), (0, 14), (1, 14), (2, 14), (3, 14), (4, 14), (5, 14)],
            fps: 15.0,
            looping: true,
        ),
        // 104-108. The descent streak, the ground splash, and standing back
        // up out of it. Five frames at 15 fps is 20 ticks, which is what
        // `plunge_impact_ticks` roots the player for.
        "plunge_impact": Clip(
            frames: [(6, 14), (0, 15), (1, 15), (2, 15), (3, 15)],
            fps: 15.0,
            looping: false,
        ),

        // --- projectiles the player throws --------------------------------
        //
        // Not the Adventurer sheet: a bolt is drawn on its own art, and a
        // clip may override the set's sheet and cell size. It lives in the
        // player's clip set rather than a set of its own because the thing
        // that throws it owns its look — `spawn::projectile` hands the
        // caster's clips straight to the bolt, and a second caster with
        // different art gets a different bolt for free.
        //
        // shockSpell.png is 4x8 cells of 64x64: four orientations of a
        // lightning strike, four frames each, in two passes down the sheet.
        // Row 0 and row 4 are the horizontal one, which is the only
        // orientation a flat-flying bolt needs — eight frames of it.
        "shock_bolt": Clip(
            frames: [
                (0, 0), (1, 0), (2, 0), (3, 0),
                (0, 4), (1, 4), (2, 4), (3, 4),
            ],
            fps: 20.0,
            looping: true,
            sheet: "shockSpell",
            frame_size: (64.0, 64.0),
        ),
    },
)
