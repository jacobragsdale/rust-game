// Adventurer sprite sheet: 7 columns x 16 rows of 50x37 frames.
//
// IMPORTANT: this sheet's animations run SEQUENTIALLY across rows, not one per
// row. Frame index i lives at cell (i % 7, i / 7), and an animation whose
// length does not divide by seven wraps onto the next row mid-swing.
//
// The layout, verified cell by cell against the art with a numbered contact
// sheet (every one of 0-108 looked at, not inferred from a pack's docs):
//
//    0-3   idle             42-46  attack1
//    4-7   crouch           47-52  attack2
//    8-13  run              53-58  attack3
//   14-17  jump             59-61  hurt
//   18-21  somersault       62-68  die
//   22-23  fall             69-72  sword draw
//   24-28  slide            73-76  sword sheath
//   29-32  stand            77-78  corner jump
//   33-37  corner grab      79-80  wall slide     <- `wall_slide`
//   38-41  idle, sword out  81-84  wall climb
//                           85-88  cast           <- `cast`
//                           89-92  cast loop      (unused: the cast is short)
//                           93-95  use item
//                           96-99  air attack 1   <- `air_attack`
//                          100-102 air attack 2
//                          103     plunge ready   <- `plunge_ready`
//                          104-105 plunge fall    <- `plunge_loop`
//                          106-108 plunge slam    <- `plunge_impact`
//   109-111 blank
//
// An earlier pass at this table missed the sword-out idle at 38-41 and three
// later strips (corner jump, wall climb, use item), which put every clip from
// the attacks on one or more frames off: `wall_slide` played the idle and a
// wind-up, `cast` played a leap and the real wall slide, the plunge played an
// item pose and the air attack, and `die` ended standing up. Traces cannot see
// any of that — they record clip names and frame indices, not cells — so this
// is the file to check by eye: `cargo run --bin sheet -- player`.
//
// 15 fps is exactly 4 ticks per frame, so an attack clip's length in ticks is
// frames * 4 -- which is what `attacks.ron` commits an attacker for.
//
// **The three swings each skip one wind-up frame** (43, 48, 54), all three
// near-copies of the frame before them. With every frame in, each crescent
// would land a frame — four ticks — after the hitbox `attacks.ron` opens for
// it; with one wind-up frame out, the crescent is on screen on exactly the
// ticks the blow is live. The hit timing is balance, tuned against the fights
// the tapes play; the art is made to agree with it rather than the other way
// round.
ClipSet(
    sheet: "playerSpriteSheet",
    frame_size: (50.0, 37.0),
    clips: {
        "idle": Clip(
            frames: [(0, 0), (1, 0), (2, 0), (3, 0)],
            fps: 8.0,
            looping: true,
        ),
        "crouch": Clip(
            frames: [(4, 0), (5, 0), (6, 0), (0, 1)],
            fps: 8.0,
            looping: true,
        ),
        "run": Clip(
            frames: [(1, 1), (2, 1), (3, 1), (4, 1), (5, 1), (6, 1)],
            fps: 12.0,
            looping: true,
        ),
        "jump": Clip(
            frames: [(0, 2), (1, 2), (2, 2), (3, 2)],
            fps: 12.0,
            looping: false,
        ),
        "double_jump": Clip(
            frames: [(4, 2), (5, 2), (6, 2), (0, 3)],
            fps: 14.0,
            looping: false,
        ),
        "fall": Clip(
            frames: [(1, 3), (2, 3)],
            fps: 8.0,
            looping: true,
        ),
        // 24-28. Five frames of going low and fast.
        "slide": Clip(
            frames: [(3, 3), (4, 3), (5, 3), (6, 3), (0, 4)],
            fps: 15.0,
            looping: false,
        ),
        // 79-80. A hand up against the wall, legs hanging.
        "wall_slide": Clip(
            frames: [(2, 11), (3, 11)],
            fps: 8.0,
            looping: true,
        ),
        // 42, 44-46: wind-up, the big downward crescent on frame 1, follow
        // through. 16 ticks of art against a 20-tick swing: the last frame
        // holds through the end of it.
        "attack1": Clip(
            frames: [(0, 6), (2, 6), (3, 6), (4, 6)],
            fps: 15.0,
            looping: false,
        ),
        // 47, 49-52: sword up, the low sweep's crescent on frame 2.
        "attack2": Clip(
            frames: [(5, 6), (0, 7), (1, 7), (2, 7), (3, 7)],
            fps: 15.0,
            looping: false,
        ),
        // 53, 55-58: the finisher. Crescent on frame 1, then the long
        // forward thrust.
        "attack3": Clip(
            frames: [(4, 7), (6, 7), (0, 8), (1, 8), (2, 8)],
            fps: 15.0,
            looping: false,
        ),
        // 96-99. Crescent on frame 1.
        "air_attack": Clip(
            frames: [(5, 13), (6, 13), (0, 14), (1, 14)],
            fps: 15.0,
            looping: false,
        ),
        // 59-61.
        "hurt": Clip(
            frames: [(3, 8), (4, 8), (5, 8)],
            fps: 10.0,
            looping: false,
        ),
        // 62-68. A real death, rather than reusing `hurt` for it, and one
        // that ends on the ground.
        "die": Clip(
            frames: [(6, 8), (0, 9), (1, 9), (2, 9), (3, 9), (4, 9), (5, 9)],
            fps: 12.0,
            looping: false,
        ),
        // 85-88. 16 ticks of `cast_ticks` + `recovery` against 4 frames at
        // 15 fps.
        "cast": Clip(
            frames: [(1, 12), (2, 12), (3, 12), (4, 12)],
            fps: 15.0,
            looping: false,
        ),

        // --- the plunge, frames 103-108 -----------------------------------
        //
        // The pack's third air attack: one sequence in the art, split into the
        // three phases the mechanic has — ready, fall, slam.

        // 103. Blade down, one frame held through the hover.
        "plunge_ready": Clip(
            frames: [(5, 14)],
            fps: 10.0,
            looping: false,
        ),
        // 104-105. Dropping with the streaks behind — two frames, looped for
        // as long as the fall lasts.
        "plunge_loop": Clip(
            frames: [(6, 14), (0, 15)],
            fps: 15.0,
            looping: true,
        ),
        // 106-108. The splash and standing back up. Three frames at 9 fps is
        // 20 ticks, which is what `plunge_impact_ticks` roots the player for.
        "plunge_impact": Clip(
            frames: [(1, 15), (2, 15), (3, 15)],
            fps: 9.0,
            looping: false,
        ),

        // --- projectiles the player throws --------------------------------
        //
        // Not the Adventurer sheet: a bolt is drawn on its own art, and a
        // clip may override the set's sheet and cell size. It lives in the
        // player's clip set rather than a set of its own because the thing
        // that throws it owns its look — `spawn::projectile` hands the
        // caster's clips straight to the bolt, and a second caster with
        // different art gets a different bolt for free.
        //
        // shockSpell.png is 4x8 cells of 64x64: four orientations of a
        // lightning strike, four frames each, in two passes down the sheet.
        // Row 0 and row 4 are the horizontal one, which is the only
        // orientation a flat-flying bolt needs — eight frames of it.
        // The tomes' spells (assets/data/items/tomes.ron), each on its own
        // pixel art under assets/graphics/creatures/.
        "frost_bolt": Clip(
            frames: [(0, 0), (1, 0)],
            fps: 12.0,
            looping: true,
            sheet: "creatures/frost",
            frame_size: (20.0, 10.0),
        ),
        "fire_bolt": Clip(
            frames: [(0, 0), (1, 0)],
            fps: 12.0,
            looping: true,
            sheet: "creatures/fireball",
            frame_size: (18.0, 14.0),
        ),
        "seeker_bolt": Clip(
            frames: [(0, 0), (1, 0)],
            fps: 10.0,
            looping: true,
            sheet: "creatures/seeker",
            frame_size: (12.0, 12.0),
        ),
        "shock_bolt": Clip(
            frames: [
                (0, 0), (1, 0), (2, 0), (3, 0),
                (0, 4), (1, 4), (2, 4), (3, 4),
            ],
            fps: 20.0,
            looping: true,
            sheet: "shockSpell",
            frame_size: (64.0, 64.0),
        ),
    },
)
