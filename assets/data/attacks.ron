// Attacks: what a swing does, separately from what it looks like.
//
// Timing is in ticks (60 = 1 second). `active` is the half-open window during
// which the hitbox exists, measured from the tick the swing started; outside
// it the attacker is committed but harmless, which is what makes an attack a
// decision rather than a free action. `recovery` extends that commitment past
// the animation — the price of a miss, and the reason spacing matters.
//
// `chain` names what this attack becomes if the player presses again at any
// point during it. That is the whole combo system: three entries and a
// pointer each, no state machine in code. Buffering any press rather than
// only ones inside a window makes the combo discoverable by mashing, which is
// what a player will do first.
//
// `offset` is measured from the attacker's collider, facing right, and is
// mirrored automatically when facing left. `knockback` is likewise rightward
// and mirrored.
//
// These numbers are balance, not art, which is why they are not in the clip
// set: the animation table should not be reopened to make a sword hit harder.
// `duration` does need to match the clip's natural length (frames * 4 ticks at
// 15 fps) or the sprite finishes before the swing does.
Attacks({
    // --- the player's three-hit ground combo -------------------------------
    //
    // Each link is slower and stronger than the last, and the finisher is what
    // actually moves an enemy. Pressing again during a swing continues the
    // chain; letting it end drops back to the first.
    "player_slash1": AttackDef(
        clip: "attack1",
        duration: 20,
        active: (4, 10),
        recovery: 4,
        chain: "player_slash2",
        offset: (14.0, 2.0),
        size: (26.0, 26.0),
        damage: 1,
        knockback: (140.0, -70.0),
        hitstun: 12,
    ),
    "player_slash2": AttackDef(
        clip: "attack2",
        duration: 24,
        active: (8, 14),
        recovery: 4,
        chain: "player_slash3",
        offset: (14.0, 2.0),
        size: (28.0, 26.0),
        damage: 1,
        knockback: (150.0, -80.0),
        hitstun: 12,
    ),
    // The finisher commits hardest: longest recovery, biggest knockback, and
    // nothing to chain into.
    "player_slash3": AttackDef(
        clip: "attack3",
        duration: 24,
        active: (5, 13),
        recovery: 10,
        offset: (16.0, 2.0),
        size: (34.0, 24.0),
        damage: 2,
        knockback: (240.0, -110.0),
        hitstun: 18,
    ),

    // --- in the air -------------------------------------------------------
    //
    // Shorter and cheaper than the ground combo, and it does not chain: an air
    // attack is a way to hit something on the way past, not a rotation to
    // stand in mid-air and grind out.
    "player_air": AttackDef(
        clip: "air_attack",
        duration: 16,
        active: (4, 10),
        recovery: 0,
        offset: (14.0, 0.0),
        size: (26.0, 26.0),
        damage: 1,
        knockback: (120.0, -60.0),
        hitstun: 10,
    ),

    // --- the plunge -------------------------------------------------------
    //
    // Down+attack in the air: hang for a moment, then drop with the blade
    // underneath you. The only attack in the table with a `Down` anchor — its
    // hitbox is centred on the player rather than mirrored with the facing,
    // and its knockback throws the victim away from the point of impact
    // rather than the way the player happens to be looking. Landing on
    // something and having it fly the wrong way is the bug that anchor exists
    // to prevent.
    //
    // The timing here is unlike every other entry: the hitbox is live for the
    // whole descent, because how long that is depends on how far up the plunge
    // started. `duration` is a ceiling — 90 ticks at 1000 px/s is 1500px of
    // fall, more than any map is tall — and the real end of the attack is the
    // ground, at which point the avatar takes over with `plunge_impact_ticks`
    // of recovery. `recovery` here is therefore 0: it would be recovery for a
    // fall that never landed.
    //
    // `offset` puts the box under the player's feet (the collider is 34 tall)
    // and slightly wider than they are, so it catches what you aimed at.
    "player_plunge": AttackDef(
        clip: "plunge_loop",
        duration: 90,
        active: (0, 90),
        recovery: 0,
        anchor: Down,
        offset: (0.0, 24.0),
        size: (30.0, 18.0),
        damage: 2,
        knockback: (200.0, -260.0),
        hitstun: 20,
    ),

    // --- the knight -------------------------------------------------------
    //
    // Slower and longer than anything the player has, with a visible wind-up
    // before the hitbox appears: an enemy attack you cannot read is just
    // damage on a timer.
    "knight_slash": AttackDef(
        clip: "attack",
        duration: 36,
        active: (16, 24),
        recovery: 0,
        offset: (16.0, 2.0),
        size: (28.0, 22.0),
        damage: 1,
        knockback: (200.0, -140.0),
        hitstun: 18,
    ),
})
