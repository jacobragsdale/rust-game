// Castle tileset: 480x480 atlas, 15 columns of 32px tiles.
// Tile indices are 0-based (Tiled gid - 1). The rule tiles were chosen to
// match how the original SuperGame castle_level.tmx used this atlas; tweak
// freely — this file is the only place tile indices exist.
//
// No color key: the PNG is palette-indexed with a tRNS chunk, so it already
// decodes with real alpha. It previously declared a magenta key, which never
// matched a pixel (the palette's masked color is cyan) and so did nothing.
//
// `platform` must draw its walkable surface in the top 8px of its tile, to
// match level::ONE_WAY_THICKNESS. Tile 181 is a decorative arch whose art
// sits in the BOTTOM 4px; using it put the collision strip entirely above
// anything visible. Tiles 195-198 are the plank platforms. See tests/assets.rs.
Tileset(
    image: "tile_castle",
    tile_size: 32,
    columns: 15,
    transparent_color: None,
    rules: Rules(
        solid_top_left: 4,
        solid_top: 5,
        solid_top_right: 6,
        solid_left: 32,
        solid_fill: 31,
        solid_right: 30,
        platform: 196,
        background: [151, 152, 153],
    ),
    // Named pieces of the atlas, as (column, row, width, height) in tiles.
    // A prop stands on the floor of the cell it is placed in and grows up and
    // to the right from there. Doors are two tiles wide and three tall, and
    // the door a `Door(...)` draws unless it says otherwise is `door`.
    props: {
        "door": (13, 11, 2, 3),
        "archway": (9, 11, 2, 3),
        "portcullis": (11, 11, 2, 3),
        "window": (0, 11, 1, 1),
        "window_lit": (1, 11, 1, 1),
        "porthole": (2, 11, 1, 1),
        "porthole_barred": (3, 11, 1, 1),
        "porthole_lit": (5, 11, 1, 1),
        "fence": (9, 14, 1, 1),
        "crate": (10, 14, 1, 1),
        "barrel": (11, 14, 1, 1),
        "torch": (12, 14, 1, 1),
        "lantern": (14, 14, 1, 1),
    },
)
