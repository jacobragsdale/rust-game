// The Ark's tileset: the Vael ship's plate, pixel art rather than a PNG
// (assets/graphics/tiles/ark.ron), 12 columns by 3 rows of 32px tiles.
// Row 0: bevelled plate in its six autotile shapes, with a lit seam along any
// face that can be walked on, then the catwalk a `=` draws. Row 1: the hull
// behind everything, in three near-identical panels, and small fittings. The
// big pieces stand at the right: a hatch, a stasis pod with somebody in it,
// and a viewport onto the world the Ark hangs over.
//
// `ark_deep.ron` and `ark_heart.ron` are this same art in another light.
Tileset(
    image: "tiles/ark",
    tile_size: 32,
    columns: 12,
    transparent_color: None,
    rules: Rules(
        solid_top_left: 0,
        solid_top: 1,
        solid_top_right: 2,
        solid_left: 3,
        solid_fill: 4,
        solid_right: 5,
        platform: 6,
        background: [12, 13, 14],
    ),
    props: {
        // What a `Door(...)` draws here unless it says otherwise.
        "hatch": (7, 0, 2, 3),
        "door": (7, 0, 2, 3),
        "archway": (7, 0, 2, 3),
        "pod": (9, 0, 1, 2),
        "viewport": (10, 0, 2, 2),
        "console": (3, 1, 1, 1),
        // A wall light, under the name every tileset's light goes by.
        "torch": (4, 1, 1, 1),
        "vent": (5, 1, 1, 1),
        "pipe": (6, 1, 1, 1),
    },
    clear: (6, 7, 14),
)
