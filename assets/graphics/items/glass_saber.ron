    frames: [
        [
            "..........kk",
            ".........kWk",
            "........kWck",
            ".......kWck.",
            "......kWck..",
            ".....kWck...",
            ".kk.kWck....",
            ".kykcck.....",
            "..kyk.......",
            ".kokyk......",
            "kok.kk......",
            "kk..........",
        ],
    ],
)
