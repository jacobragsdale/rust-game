    frames: [
        [
            "............",
            "....kkkk....",
            "...kGGGgk...",
            "..kGwGGggk..",
            "..kGGGggKk..",
            ".kgggggggKk.",
            ".kkkkkkkkkk.",
            ".kgk.kk.kgk.",
            ".kgk....kgk.",
            ".kgkk..kkgk.",
            "..kgk..kgk..",
            "...kk..kk...",
        ],
    ],
)
