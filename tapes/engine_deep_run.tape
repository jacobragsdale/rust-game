map maps/engine_deep.ron

# The Engine Deep, the Heart, and home: the end of the game. The claim: a
# fresh arrival with bare hands can take the gantry's tome, time the furnaces,
# ride the ferry past the wisps, burn the husk that waits on the far lip, walk
# the piston hall between the balls, put the sentinel down, climb the shaft
# into the forge the roof pretends to be — then go down into the Heart, kill
# the Choir, and ride the light home to Ashford for the ending.
#
# The furnaces, the ferry and the balls are timed by probing (every window here
# was searched, and the tape sits in the middle of one). The sentinel and the
# Choir were recorded with `sim --fight` and say so.

# --- the gantry -------------------------------------------------------------------
# Up the rungs by the landing and along the gantry to its chest: the Tome of
# Embers, worn in the Spell slot at once so the spark becomes a fireball.
wait 30
jump 12
wait 50
jump 12
wait 50
right+jump 20
right 95
wait 20
assert prompt == open
interact 1
expect chest_opened == 1
assert item.tome_fire.count == 1
wait 2
inventory 1
wait 1
confirm 1
wait 1
inventory 1
assert item.tome_fire.equipped
expect tome_fire.equipped == 1

# --- the furnaces -----------------------------------------------------------------
# Down through the gantry onto a clear tile, then three tiles at a time: go when
# the fire ahead goes out, stop on the next clear tile, go again. The drone over
# them throws three bolts and misses with all of them.
down 12
wait 40
wait 78
right 32
wait 25
right 32
wait 28
right 32
wait 28
right 32
wait 28
right 20
wait 20
expect checkpoint == 1
expect no player.died
expect zap.spell_cast >= 1

# --- the coolant trench -----------------------------------------------------------
# A wisp dives at you on the lip: one cut as it arrives. Then the ferry, and a
# fireball from it at the husk that waits on the far plank — it is knocked
# back off the lip, and meets the sword on solid floor when it comes again.
right 10
wait 58
attack 1
wait 30
assert wisp.0.dead
wait 150
right 12
wait 60
wait 135
cast 1
expect fireball.spell_cast == 1
wait 26
right 40
assert x > 1472
assert grounded
wait 3
right 4
attack 1
wait 8
attack 1
wait 40
assert husk.0.dead
right 25
wait 10
expect checkpoint == 2
assert hp == 5

# --- the piston hall --------------------------------------------------------------
# Over the step while the near ball is on its far side, under it as it comes
# back up, and straight on under the far one behind its swing.
wait 28
right+jump 12
right 112
wait 7
right 100
wait 10
expect checkpoint == 3
expect no player.died

