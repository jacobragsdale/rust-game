# --- after ------------------------------------------------------------------------
# The Choir's death opens the gate, and past it the Archivist's thanks is a
# trigger that waited on the same flag. Then the hatch home.
wait 30
right 200
assert mode == dialogue
expect epilogue_ark.dialogue_opened == 1
confirm 1
wait 2
confirm 1
wait 2
confirm 1
wait 2
confirm 1
wait 2
assert mode == playing
right 45
assert prompt == enter
interact 1
expect village.traveled == 1
assert map == village

# --- home -------------------------------------------------------------------------
# The light sets you down in Ashford's square, inside the homecoming trigger:
# the ending opens on its own, and closes on THE END.
wait 30
assert mode == dialogue
expect epilogue_home.dialogue_opened == 1
confirm 1
wait 2
confirm 1
wait 2
confirm 1
wait 2
assert dialogue_node == end
confirm 1
wait 2
confirm 1
wait 2
assert mode == playing
assert world.village.homecoming == 1
