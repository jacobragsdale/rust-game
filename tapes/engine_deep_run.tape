# --- end of the recording ---
assert sentinel.0.dead

# --- the forge --------------------------------------------------------------------
# The shaft at the end of the hall is a wall-jump climb, and at its top the
# roof is not roof: into the false wall, where the Starmetal Blade has waited.
wait 30
right 110
right+jump 14
right 6
left+jump 12
left 6
right+jump 12
right 6
left+jump 16
left 40
wait 20
assert y < 130
assert prompt == open
interact 1
assert item.starmetal_blade.count == 1
assert world.engine_deep.secret_forge == 1
wait 2
inventory 1
wait 1
down 1
wait 1
confirm 1
wait 1
inventory 1
assert item.starmetal_blade.equipped
wait 2

# --- down -------------------------------------------------------------------------
# Back down the shaft, and through the hatch into the Heart.
right 60
wait 40
left 35
assert prompt == enter
interact 1
expect ark_heart.traveled == 1
assert map == ark_heart
expect no player.died

# --- the Heart --------------------------------------------------------------------
# Under the low arch the Choir speaks, and the world waits for it to finish.
